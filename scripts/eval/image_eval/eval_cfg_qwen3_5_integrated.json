            "dataset": "MMBench_DEV_EN_V11"
        },
        "HRBench4K": {
            "class": "HRBenchDataset",
            "dataset": "HRBench4K"
        },
        "HallusionBench": {
            "class": "ImageYORNDataset",
            "dataset": "HallusionBench"
        },
        "AI2D_TEST": {
            "class": "ImageMCQDataset",
            "dataset": "AI2D_TEST"
        },
        "CV-Bench-2D": {
            "class": "CVBench",
            "dataset": "CV-Bench-2D"
        },
        "CV-Bench-3D": {
            "class": "CVBench",
            "dataset": "CV-Bench-3D"
        },
        "POPE": {
            "class": "ImageYORNDataset",
            "dataset": "POPE"
        },
        "VStarBench": {
            "class": "ImageMCQDataset",
            "dataset": "VStarBench"
        },
        "VisOnlyQA-VLMEvalKit": {
            "class": "ImageMCQDataset",
            "dataset": "VisOnlyQA-VLMEvalKit"
        },
        "MMStar": {
            "class": "ImageMCQDataset",
            "dataset": "MMStar"
        },
        "OCRBench": {
