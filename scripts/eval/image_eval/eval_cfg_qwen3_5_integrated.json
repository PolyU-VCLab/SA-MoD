{
    "model": {
        "MODEL_NAME_PLACEHOLDER": {
            "class": "Qwen3_5VLChat",
            "model_path": "MODEL_PATH_PLACEHOLDER",
            "min_pixels": 262144,
            "max_pixels": 16777216,
            "max_new_tokens": 512,
            "repetition_penalty": 1.0,
            "attn_implementation": "flash_attention_2",
            "report_vision_token_retention": true,
            "chat_template_kwargs": {
                "chat_template_path": "samod/chat_templates/chat_template_update.jinja",
                "enable_thinking": false,
                "force_direct_answer": true
            },
            "model_choice_kwargs": {
                "from_scratch": false,
                "samod_margin": 0.1,
                "samod_dreg_loss_weight": 0.001,
                "samod_sparsity_target": 0.05,
                "samod_weight_norm": 0.2,
                "samod_log_vision_token_retention": true,
                "ohisa_loss_weight": 1.0
            }
        }
    },
    "data": {
        "RealWorldQA": {
            "class": "ImageMCQDataset",
            "dataset": "RealWorldQA"
        },
